<?xml version="1.0" encoding="utf-8"?>
<otobo_config version="2.0" init="Changes">

    <ConfigItem Name="TicketNotifyAgent::Enabled" Required="0" Valid="1">
        <Description Translatable="1">Demo-Event-Modul aktivieren, das den Agenten beim Anlegen eines Tickets per E-Mail benachrichtigt.</Description>
        <Group>Ticket</Group>
        <SubGroup>Core::Ticket</SubGroup>
        <Setting>
            <Option SelectedID="1">
                <Item Key="0">Nein</Item>
                <Item Key="1">Ja</Item>
            </Option>
        </Setting>
    </ConfigItem>

    <ConfigItem Name="TicketNotifyAgent::Subject" Required="0" Valid="1">
        <Description Translatable="1">Betreff der Benachrichtigung. Platzhalter: &lt;OTOBO_TICKET&gt;, &lt;OTOBO_TITLE&gt;, &lt;OTOBO_QUEUE&gt;.</Description>
        <Group>Ticket</Group>
        <SubGroup>Core::Ticket</SubGroup>
        <Setting>
            <String Regex="">[OTOBO] Neues Ticket &lt;OTOBO_TICKET&gt;: &lt;OTOBO_TITLE&gt;</String>
        </Setting>
    </ConfigItem>

    <ConfigItem Name="TicketNotifyAgent::Body" Required="0" Valid="1">
        <Description Translatable="1">Text der Benachrichtigung. Leer lassen, um den Standardtext des Moduls zu verwenden. Platzhalter: &lt;OTOBO_TICKET&gt;, &lt;OTOBO_TITLE&gt;, &lt;OTOBO_QUEUE&gt;, &lt;OTOBO_STATE&gt;, &lt;OTOBO_PRIORITY&gt;, &lt;OTOBO_OWNER&gt;, &lt;OTOBO_CUSTOMER_ID&gt;, &lt;OTOBO_URL&gt;.</Description>
        <Group>Ticket</Group>
        <SubGroup>Core::Ticket</SubGroup>
        <Setting>
            <Textarea Row="8" Col="60"></Textarea>
        </Setting>
    </ConfigItem>

    <ConfigItem Name="Ticket::EventModulePost###9000-TicketNotifyAgent" Required="0" Valid="1">
        <Description Translatable="1">Registriert das Demo-Modul als Event-Handler für TicketCreate.</Description>
        <Group>Ticket</Group>
        <SubGroup>Core::Ticket</SubGroup>
        <Setting>
            <Hash>
                <Item Key="Module">Kernel::System::Ticket::Event::TicketNotifyAgent</Item>
                <Item Key="Event">TicketCreate</Item>
            </Hash>
        </Setting>
    </ConfigItem>

</otobo_config>
